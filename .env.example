# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git - it holds secrets.

# ---- Bitrix24 ----
# Your inbound webhook URL, created inside Bitrix24 under
# CRM > Settings > Developer resources > Other > Inbound webhook.
# Format: https://<portal>.bitrix24.com/rest/<user id>/<token>/
# Keep the trailing slash. See README.md for exactly which scopes to tick.
BITRIX24_WEBHOOK_URL=

# ---- Bitrix24 auth mode: "webhook" (default) or "app" ----
# Webhook mode is simple and needs nothing below. But Bitrix24 refuses some
# methods to webhooks no matter how privileged the account is:
#   - bizproc.workflow.template.add/update  ("Application context required")
#   - userfieldconfig.add                   (needs portal admin)
#   - crm.item.productrow.*                 (access denied)
# App mode authenticates as a registered local application acting for the
# user who authorised it, which lifts all three. Flip this one variable to
# switch, and flip it back to roll straight back to the webhook.
BITRIX24_AUTH_MODE=webhook

# ---- Local application credentials (app mode only) ----
# Create a DEDICATED local app for this server under
# Developer resources > Other > Local application. Do NOT reuse an app that
# another service (e.g. your website) already uses: Bitrix24 rotates refresh
# tokens and invalidates the old one on every refresh, so two services
# sharing one app will silently revoke each other, producing intermittent
# auth failures that are painful to diagnose.
# Required scopes: crm, bizproc, catalog, task, user, department, sale, lists
# Portal domain only - no https://, no trailing slash.
BITRIX24_PORTAL=
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=

# A freshly authorised refresh token. This is a SEED ONLY: after the first
# refresh the server stores the rotated token in MCP_DATA_DIR and ignores
# this value. If that stored file is lost the app must be re-authorised and
# this reseeded - so on Railway, mount a volume at MCP_DATA_DIR, because the
# container filesystem is wiped on every redeploy.
BITRIX24_REFRESH_TOKEN=

# ---- This server's own identity ----
# The public HTTPS URL this server will be reachable at once deployed
# (no trailing slash). Used as the OAuth issuer/resource URL, so Claude
# can find the /authorize, /token and /mcp endpoints.
# Example: https://mcp.novelsolar.com  or  https://novelsolar.com/bitrix-mcp
MCP_SERVER_URL=

# A password only you know. When Claude's OAuth flow opens a browser tab
# to log in, you'll be asked to type this once. Make it long and random -
# it is the only thing standing between the internet and your Bitrix24 data.
MCP_LOGIN_PASSPHRASE=

# ---- Optional ----
# Port the server listens on. Railway sets this automatically. On cPanel/
# Passenger hosting, cPanel sets this for you too - you normally don't need
# to set it yourself.
PORT=3000

# Where the server persists OAuth clients/tokens and the rotated Bitrix24
# refresh token. Defaults to ./data. On Railway this MUST point at a mounted
# volume, or everything here is lost on each redeploy.
MCP_DATA_DIR=data
